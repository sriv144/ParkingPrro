    "/api/v1/lots": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "latitude",
            "schema": {
              "type": "number",
              "default": 12.9716,
              "minimum": -90.0,
              "maximum": 90.0
            },
            "required": false
          },
          {
            "in": "query",
            "name": "longitude",
            "schema": {
              "type": "number",
              "default": 77.5946,
              "minimum": -180.0,
              "maximum": 180.0
            },
            "required": false
          },
          {
            "in": "query",
            "name": "radius_m",
            "schema": {
              "type": "integer",
              "default": 10000,
              "minimum": 250,
              "maximum": 50000
            },
            "required": false
          },
          {
            "in": "query",
            "name": "starts_at",
            "schema": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time",
              "default": null
            },
            "required": false
          },
          {
            "in": "query",
            "name": "ends_at",
            "schema": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time",
              "default": null
            },
            "required": false
          },
          {
            "in": "query",
            "name": "spot_type",
            "schema": {
              "type": [
                "string",
                "null"
              ],
              "default": null,
              "enum": [
                "car",
                "bike",
                "ev",
                "accessible",
                null
              ]
            },
            "required": false
          }
        ],
        "responses": {
          "422": {
            "$ref": "#/components/responses/UNPROCESSABLE_ENTITY"
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Lot"
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "tags": [
          "lots"
        ]
      }
    },
