FROM python:3.12-slim AS builder
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
WORKDIR /build
COPY backend/pyproject.toml backend/requirements.txt ./
COPY backend/parkingpro ./parkingpro
RUN python -m venv /opt/venv && /opt/venv/bin/pip install .

FROM python:3.12-slim AS runtime
ENV PATH="/opt/venv/bin:$PATH" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update \
    && apt-get upgrade --yes --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system parkingpro \
    && useradd --system --gid parkingpro --home /app parkingpro
WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY --chown=parkingpro:parkingpro backend/parkingpro ./parkingpro
COPY --chown=parkingpro:parkingpro backend/migrations ./migrations
COPY --chown=parkingpro:parkingpro backend/pyproject.toml backend/migrations/alembic.ini ./
USER parkingpro
EXPOSE 5000
CMD ["sh", "-c", "exec gunicorn --bind 0.0.0.0:${PORT:-5000} --workers 2 --threads 4 --timeout 90 --access-logfile - parkingpro.wsgi:app"]
