FROM node:22-alpine AS builder
WORKDIR /workspace
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/operator-web/package.json apps/operator-web/package.json
COPY apps/mobile/package.json apps/mobile/package.json
COPY packages/api-contracts/package.json packages/api-contracts/package.json
COPY packages/design-tokens/package.json packages/design-tokens/package.json
RUN npm ci --ignore-scripts --workspace @parkingpro/operator-web
COPY apps/operator-web apps/operator-web
COPY packages packages
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build --workspace @parkingpro/operator-web

FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime
COPY infrastructure/docker/operator-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /workspace/apps/operator-web/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
